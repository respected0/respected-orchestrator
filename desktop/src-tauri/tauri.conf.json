{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respected Orchestrator",
  "version": "0.1.0-beta.4",
  "identifier": "com.respected.orchestrator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Respected Orchestrator", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
